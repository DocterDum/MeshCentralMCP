# MeshCentral server and a login token created in My Account.
MESH_SERVER_URL=https://mesh.example.com
MESH_TOKEN_USER=~t:xxxxxxxxxxxxxxxx
MESH_TOKEN_PASS=xxxxxxxxxxxxxxxxxxxx

# readonly (default): list tools only. support: also registers mesh_run_command.
MESH_PROFILE=readonly

# Optional: comma-separated device group names this instance may see.
# Strongly recommended: run one instance per customer.
# MESH_GROUPS=Customer A,Customer A Servers

# Where the JSONL audit log of every command is written.
# MESH_AUDIT_LOG=audit.jsonl

# Only for --http mode: bearer token clients must send (24+ characters).
# MCP_HTTP_TOKEN=
