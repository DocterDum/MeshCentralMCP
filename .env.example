# MeshCentral server and a login token created in My Account.
MESH_SERVER_URL=https://mesh.example.com
MESH_TOKEN_USER=~t:xxxxxxxxxxxxxxxx
MESH_TOKEN_PASS=xxxxxxxxxxxxxxxxxxxx

# Where the JSONL audit log of every command is written.
# MESH_AUDIT_LOG=audit.jsonl

# How Claude connects: stdio (default, local process), http or https.
# MCP_TRANSPORT=https
# Address for http/https. Default 0.0.0.0:8808 (all interfaces); use 127.0.0.1:8808 for local only.
# MCP_LISTEN=0.0.0.0:8808

# https only: PEM certificate and its private key. Both are needed.
# If unset, a self-signed certificate is created in mcp-tls/.
# MCP_TLS_CERT=/etc/ssl/mcp/fullchain.pem
# MCP_TLS_KEY=/etc/ssl/mcp/privkey.pem
# Extra host names for the self-signed certificate (comma separated).
# MCP_TLS_NAMES=mcp.example.com

# http/https: the bearer token (meshmcp_...) is generated on first start and stored here.
# MCP_HTTP_TOKEN_FILE=mcp-http-token.txt
